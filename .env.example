# Public site origin used for canonical URLs and sitemap generation.
PUBLIC_SITE_URL=https://thewebguy.app

# Public GA4 measurement ID used by the client-side analytics layer.
# Example: G-XXXXXXXXXX. This value is not a secret.
PUBLIC_GA_MEASUREMENT_ID=

# Public tawk.to live chat settings. These values are not secrets.
# These IDs match the installed public widget script and can be overridden locally.
PUBLIC_TAWK_ENABLED=true
PUBLIC_TAWK_AUTO_START=true
PUBLIC_TAWK_PROPERTY_ID=6a43edcd82c4e81d44ac79af
PUBLIC_TAWK_WIDGET_ID=1jsclhqsd
PUBLIC_TAWK_HIDE_WHEN_OFFLINE=true
PUBLIC_TAWK_ALLOWED_HOSTS=thewebguy.app,www.thewebguy.app,localhost,127.0.0.1
PUBLIC_TAWK_Z_INDEX=70
PUBLIC_TAWK_DESKTOP_POSITION=br
PUBLIC_TAWK_DESKTOP_X_OFFSET=18
PUBLIC_TAWK_DESKTOP_Y_OFFSET=18
PUBLIC_TAWK_MOBILE_POSITION=br
PUBLIC_TAWK_MOBILE_X_OFFSET=12
PUBLIC_TAWK_MOBILE_Y_OFFSET=12

# Server-only contact email settings. Copy these into .env.local for local dev.
# Do not commit real recipient addresses, SMTP usernames, or SMTP passwords.
CONTACT_EMAIL_PROVIDER=gmail
CONTACT_TO_EMAIL=recipient@example.com
CONTACT_FROM_EMAIL="The Web Guy <sender@example.com>"

# Gmail API settings. Recommended for Render free hosting because it sends over HTTPS,
# not blocked SMTP ports. CONTACT_FROM_EMAIL must be the Gmail account or an approved send-as alias.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_ID=me

# Optional one-time Gmail OAuth setup route.
# Add https://thewebguy.app/api/admin/gmail-oauth/callback as an authorized redirect URI
# in Google Cloud before using the setup URL.
CONTACT_OAUTH_SETUP_KEY=replace-with-long-random-secret
GMAIL_REDIRECT_URI=https://thewebguy.app/api/admin/gmail-oauth/callback

# Optional Render API auto-update for GMAIL_REFRESH_TOKEN after OAuth setup.
# If RENDER_API_KEY is missing, the setup callback shows a copyable token instead.
RENDER_API_KEY=
CONTACT_OAUTH_TRIGGER_DEPLOY=true

# Generic SMTP settings. Useful for local dev, paid hosting, or hosts that allow SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
